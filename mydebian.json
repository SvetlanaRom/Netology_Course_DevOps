{
      "variables": {
        "yandex_token": "{{env `IAM_TOKEN`}}"
      },   
      "builders": [
        {
            "type": "yandex",
            "token": "{{user `yandex_token`}}",
            "folder_id": "b1guvkrsdeqotm0kng2g",
            "zone": "ru-central1-d",
            "image_name": "debian-11-docker",
            "image_description": "my custom debian with docker",
            "source_image_family": "debian-11",
            "subnet_id": "fl86ilupm881ib34fj0n",
            "use_ipv4_nat": true,
            "disk_type": "network-hdd",
            "ssh_username": "debian"
        }
    ],
    "provisioners": [
        {
            "type": "shell",
            "inline": [
                "sudo apt update",
				"sudo apt install -y ca-certificates curl git htop tmux",
                "curl -fsSL get.docker.com -o get.docker.sh",
				"sudo chmod +x get.docker.sh",
				"sudo ./get.docker.sh"
            ]
        }
    ]
}
